    "highlight.js": "^11.12.0",
    "lodash": "^4.18.1",
    "marked": "^18.0.9",
    "moment": "^2.30.1",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.3.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.55.3",
    "@rushstack/eslint-patch": "^1.8.0",
    "@tailwindcss/line-clamp": "^0.4.4",
